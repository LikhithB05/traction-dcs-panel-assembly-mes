# Local Node.js Server (Legacy / Rollback)
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/bhel_portal.sqlite
JWT_SECRET=replace_with_a_secure_64_char_random_hex_secret

# Cloudflare Worker Local Development (place in worker/.dev.vars)
# NODE_ENV=development
# JWT_SECRET=replace_with_a_secure_64_char_random_hex_secret

# Optional initial seed PINs for fresh database initialization (defaults to dev-*-pin in local dev)
SEED_PIN_KSM=change-me-ksm
SEED_PIN_PDR=change-me-pdr
SEED_PIN_CRM=change-me-crm
SEED_PIN_AKR=change-me-akr
SEED_PIN_CKG=change-me-ckg
