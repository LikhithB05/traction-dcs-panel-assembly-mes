{
  "name": "bhel-panel-portal-monorepo",
  "version": "1.0.0",
  "description": "BHEL Traction & DCS Panel Assembly Management Portal",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:install": "cd server && npm install",
    "client:install": "cd client && npm install",
    "install:all": "npm run server:install && npm run client:install",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "test": "cd server && npm test",
    "seed": "cd server && node src/db/seed.js"
  },
  "keywords": [
    "bhel",
    "manufacturing",
    "mes",
    "panel-assembly"
  ],
  "author": "BHEL Project Team",
  "license": "ISC"
}
